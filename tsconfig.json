{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "app/*": ["app/*"],
      "pages/*": ["pages/*"],
      "features/*": ["features/*"],
      "shared/*": ["shared/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["app", "pages", "features", "shared", "vite.config.ts", "playwright.config.ts", "e2e"],
  "exclude": ["node_modules", "prototype"]
}
